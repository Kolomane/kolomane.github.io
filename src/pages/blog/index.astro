---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import FormattedDate from '../../components/FormattedDate.astro';
import Navbar from '../../components/Navbar.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!DOCTYPE html>
<html lang="en" data-theme="dracula">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cybersecurity writing by kolomane." />
    <title>Blog - kolomane</title>
  </head>
  <body class="bg-base-100 text-base-content min-h-screen flex flex-col">
    <Navbar outerClass="lg:mb-16" />

    <main class="max-w-5xl mx-auto px-6 py-10 flex-1 w-full">
      <h1 class="text-3xl font-bold mb-2">All posts</h1>
      <p class="text-base-content/60 mb-8">Browse everything in reverse chronological order.</p>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block bg-base-200 rounded-xl p-4 hover:bg-base-300 transition-colors h-full">
                {post.data.heroImage && (
                  <Image
                    width={720}
                    height={360}
                    src={post.data.heroImage}
                    alt=""
                    class="rounded-lg mb-3 group-hover:shadow-lg transition-shadow"
                  />
                )}
                <h2 class="text-lg font-semibold mb-1 group-hover:text-primary transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-xs text-base-content/60 mb-2">
                  <FormattedDate date={post.data.pubDate} />
                </p>
                {post.data.description && (
                  <p class="text-sm text-base-content/70 line-clamp-3">
                    {post.data.description}
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <footer class="footer footer-center p-6 bg-base-200 border-t border-base-300 text-base-content/50 text-sm mt-12">
      <p>Opinions are my own. Not legal advice.</p>
    </footer>
  </body>
</html>
