---
/**
 * <RedTape>red tape</RedTape> — bold red, with an occasional shimmer.
 * Each instance gets its own phase so they don't all flash in sync.
 */
const delay = -(Math.random() * 7).toFixed(2);
---
<strong class="red-tape" style={`animation-delay: ${delay}s`}><slot /></strong>

<style is:global>
  .red-tape {
    font-weight: 700;
    color: #ff5555;
    background: linear-gradient(100deg, #ff5555 42%, #ffd6d6 50%, #ff5555 58%);
    background-size: 260% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: red-tape-shimmer 7s ease-in-out infinite;
  }
  /* Idle most of the cycle, then one quick sweep. */
  @keyframes red-tape-shimmer {
    0%, 84% { background-position: 100% 0; }
    100% { background-position: -60% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .red-tape { animation: none; background: none; -webkit-text-fill-color: #ff5555; }
  }
</style>
